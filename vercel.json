{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "regions": ["fra1"],
  "functions": {
    "api/index.js": { "maxDuration": 30, "includeFiles": "public/**" }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index" }],
  "crons": [{ "path": "/api/cron/daily", "schedule": "0 1 * * *" }]
}
